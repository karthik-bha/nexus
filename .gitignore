.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.parcel-cache

# Frontend Specific (React)
# React development often generates these files.
/public/build
/public/dist

